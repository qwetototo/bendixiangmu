VITE_MQTT_WS_URL=ws://user.deepfusionrobotics.com
VITE_TRAJECTORY_API_URL=/api/trajectory/points

# 默认语言 (zh-CN | en)，构建时生效
#   yarn build:zh   -> zh-CN
#   yarn build:en   -> en
VITE_DEFAULT_LOCALE=zh-CN

# 管理员联系方式，登录页「忘记密码」弹窗中展示
VITE_ADMIN_CONTACT=admin@deepfusionrobotics.com

# 地图编辑「基本信息」中「前往地图选择建筑」按钮跳转的目标地址（支持裸域名或完整 URL）
VITE_BUILDING_SELECT_URL=map.deepfusionrobotics.com
